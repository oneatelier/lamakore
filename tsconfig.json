{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"],
    "noEmit": true,
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true
  },
  "include": ["packages/branding/src/**/*.ts", "packages/ui/src/**/*.ts", "apps/**/*.ts", "apps/**/*.tsx", "tests/**/*.ts"]
}
