{
  "name": "project-one",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Open-source unified agent desktop (Electron + Rust)",
  "packageManager": "pnpm@12.22.0",
  "engines": {
    "node": "24"
  },
  "scripts": {
    "branding:codegen": "node scripts/branding-codegen.mjs",
    "lint": "node scripts/lint/no-hardcoded-brand.mjs && node scripts/lint/no-raw-hex.mjs && node scripts/lint/check-fonts.mjs",
    "test": "node --test tests/hygiene/scanners.spec.ts tests/branding/rename.spec.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build:desktop": "node scripts/build-desktop.mjs",
    "test:e2e": "node --test tests/e2e/handshake.spec.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "electron": "45.4.1",
    "esbuild": "^0.28.2",
    "gifenc": "^1.0.3",
    "pngjs": "^7.0.0",
    "puppeteer": "^25.18.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2"
  }
}
